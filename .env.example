# ============================================
# KABAZA BACKEND - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file!

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=sqlite:///./kabaza.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/kabaza

# Redis
REDIS_URL=redis://localhost:6379
# For production with password: REDIS_URL=redis://:password@host:port

# ============================================
# PAYMENT PROVIDERS (Malawi)
# ============================================

# TNM Mpamba
TNM_MPAMBA_API_KEY=your_tnm_api_key_here
TNM_MPAMBA_API_SECRET=your_tnm_api_secret_here
TNM_MPAMBA_SANDBOX=true

# Airtel Money
AIRTEL_API_KEY=your_airtel_api_key_here
AIRTEL_API_SECRET=your_airtel_api_secret_here
AIRTEL_SANDBOX=true

# ============================================
# NOTIFICATIONS
# ============================================

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_SENDER_ID=your_fcm_sender_id_here

# Apple Push Notification Service
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apns_team_id
APNS_BUNDLE_ID=com.kabaza.app
APNS_USE_SANDBOX=true

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# GOOGLE SERVICES
# ============================================

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ============================================
# EMAIL (For future use)
# ============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@kabaza.com

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_SMS_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_SURGE_PRICING=true
ENABLE_REFERRAL_SYSTEM=true